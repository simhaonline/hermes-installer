def cmd_check_rule(rule_id: str) -> int:
    """Evaluates an individual rule by ID and returns POSIX exit code."""
    rule_id = rule_id.upper()
    rule = RULES_DB.get(rule_id)
    if not rule:
        print(f"{RED}{BOLD}Error:{RESET} Rule '{rule_id}' not found in governance database.")
        print(f"Available rules: {', '.join(sorted(RULES_DB.keys())[:10])}... (total: {len(RULES_DB)})")
        return EXIT_ERROR

    passed, message = rule["check_fn"]()
    status_str = f"{EMERALD}{BOLD}[ PASS ]{RESET}" if passed else f"{RED}{BOLD}[ FAIL ]{RESET}"
    sev_color = RED if rule["severity"] == "CRITICAL" else (AMBER if rule["severity"] == "HIGH" else CYAN)

    print(f"\n{BOLD}Rule Verification Details:{RESET}")
    print(f"  {BOLD}Rule ID:{RESET}          {GOLD}{rule_id}{RESET}")
    print(f"  {BOLD}Protocol:{RESET}         {rule['protocol']} (Protocol 0{rule['proto_num']})")
    print(f"  {BOLD}Severity:{RESET}         {sev_color}{rule['severity']}{RESET}")
    print(f"  {BOLD}Threat Mitigated:{RESET} {rule['threat']}")
    print(f"  {BOLD}Evidence Base:{RESET}    {rule['evidence']}")
    print(f"  {BOLD}Autofixable:{RESET}      {'Yes' if rule['autofix'] else 'No'}")
    print(f"  {BOLD}Rule Statement:{RESET}   {rule['statement']}")
    print(f"  {BOLD}Evaluation:{RESET}       {status_str} {message}\n")

    return EXIT_PASS if passed else EXIT_CRITICAL_FAIL

def cmd_enforce(args) -> int:
    """Executes batch rule evaluation with strict exit code reporting."""
    print_banner()

    target_proto = None
    if args.protocol:
        p_arg = str(args.protocol).strip().lower()
        if p_arg.isdigit():
            target_proto = int(p_arg)
        else:
            for num, name in PROTOCOL_NAMES.items():
                if p_arg in name.lower():
                    target_proto = num
                    break

    rules_to_run = {
        rid: r for rid, r in RULES_DB.items()
        if target_proto is None or r["proto_num"] == target_proto
    }

    if not rules_to_run:
        print(f"{RED}No rules found matching protocol criteria '{args.protocol}'.{RESET}")
        return EXIT_ERROR

    scope_title = f"Protocol 0{target_proto}: {PROTOCOL_NAMES.get(target_proto)}" if target_proto else "All 8 Governance Protocols"
    print(f"{BOLD}Enforcing Sovereign Ruleset:{RESET} {GOLD}{scope_title}{RESET} ({len(rules_to_run)} rules evaluated)\n")

    passed_count = 0
    fail_critical = 0
    fail_high = 0
    fail_warn = 0

    results = []

    for rid in sorted(rules_to_run.keys()):
        r = rules_to_run[rid]
        passed, msg = r["check_fn"]()
        results.append({
            "rule_id": rid,
            "protocol": r["protocol"],
            "severity": r["severity"],
            "passed": passed,
            "message": msg
        })

        if passed:
            passed_count += 1
            status_tag = f"{EMERALD}[PASS]{RESET}"
        else:
            if r["severity"] == "CRITICAL":
                fail_critical += 1
                status_tag = f"{RED}[FAIL-CRIT]{RESET}"
            elif r["severity"] == "HIGH":
                fail_high += 1
                status_tag = f"{RED}[FAIL-HIGH]{RESET}"
            else:
                fail_warn += 1
                status_tag = f"{AMBER}[WARN]{RESET}"

        sev_tag = f"[{r['severity']}]"
        print(f"  {status_tag:<18} {GOLD}{rid:<8}{RESET} {DIM}{sev_tag:<10}{RESET} {r['statement'][:60]}...")

    print(f"\n{BOLD}{'=' * 78}{RESET}")
    print(f"{BOLD}Execution Summary:{RESET} Total: {len(rules_to_run)} | {EMERALD}Passed: {passed_count}{RESET} | "
          f"{RED}Critical: {fail_critical}{RESET} | {RED}High: {fail_high}{RESET} | {AMBER}Warnings: {fail_warn}{RESET}")

    state_hash = compute_state_hash()
    print(f"{DIM}Cryptographic State Attestation: SHA-256:{state_hash[:32]}...{RESET}\n")

    if args.json:
        out_payload = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "state_hash": state_hash,
            "summary": {
                "total": len(rules_to_run),
                "passed": passed_count,
                "critical_failures": fail_critical,
                "high_failures": fail_high,
                "warnings": fail_warn
            },
            "results": results
        }
        print(json.dumps(out_payload, indent=2))

    if fail_critical > 0 or fail_high > 0:
        print(f"{RED}{BOLD}GATE REJECTED:{RESET} Release blocked by failing CRITICAL or HIGH governance rules.")
        return EXIT_CRITICAL_FAIL
    elif fail_warn > 0 and args.strict:
        print(f"{AMBER}{BOLD}GATE BLOCKED:{RESET} Warnings present under --strict mode.")
        return EXIT_WARN
    else:
        print(f"{EMERALD}{BOLD}SOVEREIGN PASS:{RESET} All evaluated governance rules passed verification.")
        return EXIT_PASS

