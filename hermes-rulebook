        except Exception as e:
            print(f"{RED}Failed to parse profiles.json: {e}{RESET}")
            return EXIT_ERROR

    runtime_profiles_dir = Path("/home/predictatrade/.hermes/profiles")
    active_profile = "agentic-search-optimizer"

    print(f"{BOLD}Auditing Specialist Runtime Profiles (Total Catalog: {len(profiles_data)} profiles){RESET}\n")

    target_list = profiles_data
