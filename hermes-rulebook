def main():
    drop_privileges_if_root()

    p = argparse.ArgumentParser(
        prog="hermes-rulebook",
        description="Simha Nexus Enterprise Governance Engine & Rulebook CLI (v2.0.0)"
    )

    sub = p.add_subparsers(dest="subcommand", help="Governance Commands")

    # 1. enforce
    p_enf = sub.add_parser("enforce", help="Enforce governance rules and return strict exit codes")
    p_enf.add_argument("--protocol", "-p", default=None, help="Protocol number (1-8) or name to enforce")
    p_enf.add_argument("--profile", default=None, help="Validate within the context of a runtime profile")
    p_enf.add_argument("--strict", action="store_true", help="Fail with exit code 2 on warnings")
    p_enf.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # 2. validate
    p_val = sub.add_parser("validate", help="Validate specialist runtime profiles against schemas")
    p_val.add_argument("--profile", default=None, help="Profile ID/name to validate")
    p_val.add_argument("--all", action="store_true", help="Validate all 66 specialist runtime profiles")

    # 3. report
    p_rep = sub.add_parser("report", help="Generate cryptographic compliance attestation report")
    p_rep.add_argument("--format", choices=["md", "json", "text"], default="md", help="Output format (default: md)")

    # 4. check
    p_chk = sub.add_parser("check", help="Evaluate a single governance rule by ID")
    p_chk.add_argument("rule_id", help="Rule identifier (e.g., SEC-001, SWM-003, ENG-001)")

    # 5. list
    sub.add_parser("list", help="List all 8 governance protocol divisions")

    # 6. view
    p_view = sub.add_parser("view", help="View protocol directives and rules")
    p_view.add_argument("protocol", type=int, help="Protocol number (1-8)")

    # 7. search
    p_search = sub.add_parser("search", help="Search governance rules by keyword")
    p_search.add_argument("query", help="Search keyword or regex")

    # 8. export-yaml
    sub.add_parser("export-yaml", help="Export top 20 critical rules YAML rule pack")

    # Positional shortcut support (e.g. `hermes-rulebook 1` or `hermes-rulebook SEC-001`)
    p.add_argument("shortcut", nargs="?", default=None, help="Shortcut: protocol number (1-8) or rule ID")

    args = p.parse_args()

    if args.subcommand == "enforce":
        sys.exit(cmd_enforce(args))
    elif args.subcommand == "validate":
        sys.exit(cmd_validate_profile(args.profile, args.all))
    elif args.subcommand == "report":
        sys.exit(cmd_generate_report(args.format))
    elif args.subcommand == "check":
        sys.exit(cmd_check_rule(args.rule_id))
    elif args.subcommand == "list":
        cmd_list_protocols()
        sys.exit(EXIT_PASS)
    elif args.subcommand == "view":
        cmd_view_protocol(args.protocol)
        sys.exit(EXIT_PASS)
    elif args.subcommand == "search":
        cmd_search(args.query)
        sys.exit(EXIT_PASS)
    elif args.subcommand == "export-yaml":
        cmd_export_yaml()
        sys.exit(EXIT_PASS)
    elif args.shortcut:
        if args.shortcut.isdigit():
            cmd_view_protocol(int(args.shortcut))
            sys.exit(EXIT_PASS)
        elif "-" in args.shortcut:
            sys.exit(cmd_check_rule(args.shortcut))
        else:
            cmd_search(args.shortcut)
            sys.exit(EXIT_PASS)
    else:
        cmd_list_protocols()
        sys.exit(EXIT_PASS)

if __name__ == "__main__":
    main()
