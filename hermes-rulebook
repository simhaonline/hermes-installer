PROTOCOL_NAMES = {
    1: "Security & Isolation",
    2: "AI CLI Ecosystem",
    3: "Swarm Architecture",
    4: "Runtime Profiles",
    5: "MCP Universe & Tools",
    6: "Native Ecosystem Engines",
    7: "Swiss Bullion Standard",
    8: "Repository Discipline"
}

def compute_state_hash() -> str:
    """Computes a deterministic cryptographic SHA-256 hash representing the governance state."""
    hasher = hashlib.sha256()
    hasher.update(b"SIMHA_NEXUS_GOVERNANCE_V2.0.0\n")
    for rid in sorted(RULES_DB.keys()):
        r = RULES_DB[rid]
        hasher.update(f"{rid}|{r['protocol']}|{r['severity']}|{r['statement']}\n".encode("utf-8"))
    return hasher.hexdigest()

def parse_rulebook_protocols(content: str) -> List[Dict[str, Any]]:
    """Extracts protocol sections from markdown content."""
    protocols = []
    pattern = r"## Protocol (\d+):\s*([^\n]+)\n(.*?)(?=\n## Protocol \d+:|\n---\n\*Simha|\n---\n\*Hermes|\Z)"
    matches = re.findall(pattern, content, re.DOTALL)
    for num, title, body in matches:
        protocols.append({
            "protocol": int(num),
            "title": title.strip(),
            "body": body.strip(),
            "rules_count": sum(1 for r in RULES_DB.values() if r["proto_num"] == int(num))
        })
    return protocols

