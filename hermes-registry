    async function executeSearch() {
      const q = document.getElementById('searchQuery').value.trim();
      const cat = document.getElementById('filterCategory').value;
      const targetProf = document.getElementById('targetProfile').value;

      document.getElementById('resultsCount').innerText = 'Searching hybrid vector registry...';
      const grid = document.getElementById('skillsGrid');
      grid.innerHTML = '<div style="color: var(--text-muted); padding: 1rem;">Resolving semantic vectors & full-text indexes...</div>';

      try {
        const url = `/api/search?q=${encodeURIComponent(q)}&category=${encodeURIComponent(cat)}&limit=24`;
        const res = await fetch(url);
        const data = await res.json();
        const items = data.results || [];

        document.getElementById('resultsCount').innerText = `Resolved ${items.length} relevant tools`;
        grid.innerHTML = '';

        if (items.length === 0) {
          grid.innerHTML = '<div style="color: var(--text-muted); padding: 2rem;">No matching tools found. Try another search query.</div>';
          return;
        }

        const activeSet = new Set(activeSkills[targetProf] || []);

        items.forEach(item => {
          const card = document.createElement('div');
          card.className = 'skill-card';
          const isActive = activeSet.has(item.name);

          let badgeHtml = '';
          if (item.match_type === 'semantic') {
            badgeHtml = `<span class="match-badge">${(item.score * 100).toFixed(0)}% Semantic</span>`;
          } else {
            badgeHtml = `<span class="match-badge keyword">BM25 Match</span>`;
          }

          card.innerHTML = `
            <div>
              <div class="card-top">
                <span class="skill-title">${escapeHtml(item.name)}</span>
                ${badgeHtml}
              </div>
              <div class="card-category">📁 ${escapeHtml(item.category)}</div>
              <div class="card-desc">${escapeHtml(item.description || 'No description provided.')}</div>
            </div>
            <div class="card-actions">
              <button class="btn-action" onclick="viewSkill('${escapeHtml(item.name)}')">Inspect Docs</button>
              ${isActive ? 
                `<button class="btn-action btn-deactivate" onclick="toggleSkill('${escapeHtml(item.name)}', 'deactivate')">Deactivate</button>` : 
                `<button class="btn-action btn-activate" onclick="toggleSkill('${escapeHtml(item.name)}', 'activate')">+ Activate</button>`
              }
            </div>
          `;
          grid.appendChild(card);
        });
      } catch (e) {
        grid.innerHTML = `<div style="color: var(--danger); padding: 1rem;">Search error: ${e.message}</div>`;
      }
    }

    async function toggleSkill(skill, action) {
      const targetProf = document.getElementById('targetProfile').value;
      try {
        const res = await fetch(`/api/${action}`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({skill: skill, profile: targetProf})
        });
        const data = await res.json();
        if (data.success) {
          showToast(`✅ ${data.message}`);
          await loadProfiles();
          executeSearch();
        } else {
          showToast(`❌ Error: ${data.error}`);
        }
      } catch (e) {
        showToast(`❌ Failed: ${e.message}`);
      }
    }

    async function viewSkill(name) {
