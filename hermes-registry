          document.getElementById('cntCurated').innerText = (data.counts.curated_skills || 19691).toLocaleString();
          document.getElementById('cntCommunity').innerText = (data.counts.community_skills || 64687).toLocaleString();
          document.getElementById('cntProfiles').innerText = data.counts.profiles || 66;
          document.getElementById('cntMCP').innerText = (data.counts.recommended_mcp || 45) + ' / ' + (data.counts.mcp_servers || 4837);
          document.getElementById('cntPlugins').innerText = data.counts.plugins || 32;
        }
      } catch (e) { console.error(e); }
