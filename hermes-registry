def main():
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="subcommand", required=True)

    sub.add_parser("stats", help="Display hybrid registry statistics")

    p_res = sub.add_parser("resolve", help="Resolve tools dynamically from natural language intent")
    p_res.add_argument("query", help="Natural language description of task or intent")
    p_res.add_argument("--limit", type=int, default=5, help="Number of tools to return")

    p_act = sub.add_parser("activate", help="Dynamically activate/install a skill into profile context")
    p_act.add_argument("skill", help="Name of skill to activate")
    p_act.add_argument("--profile", default="default", help="Target profile name")

    p_inst = sub.add_parser("install", help="Alias for activate")
    p_inst.add_argument("skill", help="Name of skill to install")
    p_inst.add_argument("--profile", default="default", help="Target profile name")

    p_deact = sub.add_parser("deactivate", help="Evict a skill from profile context")
    p_deact.add_argument("skill", help="Name of skill to deactivate")
    p_deact.add_argument("--profile", default="default", help="Target profile name")

    p_uninst = sub.add_parser("uninstall", help="Alias for deactivate")
    p_uninst.add_argument("skill", help="Name of skill to uninstall")
    p_uninst.add_argument("--profile", default="default", help="Target profile name")

    p_ui = sub.add_parser("ui", help="Launch interactive Web Dashboard")
    p_ui.add_argument("--host", default="0.0.0.0", help="Binding host (default 0.0.0.0)")
    p_ui.add_argument("--port", type=int, default=8888, help="Port to serve on (default 8888)")

    p_dash = sub.add_parser("dashboard", help="Alias for ui")
    p_dash.add_argument("--host", default="0.0.0.0", help="Binding host (default 0.0.0.0)")
    p_dash.add_argument("--port", type=int, default=8888, help="Port to serve on (default 8888)")

    args = p.parse_args()
    if args.subcommand == "stats":
        cmd_stats(args)
    elif args.subcommand == "resolve":
        cmd_resolve(args)
    elif args.subcommand in ("activate", "install"):
        cmd_activate(args)
    elif args.subcommand in ("deactivate", "uninstall"):
        cmd_deactivate(args)
    elif args.subcommand in ("ui", "dashboard"):
        cmd_ui(args)

if __name__ == "__main__":
    main()
