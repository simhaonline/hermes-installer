      try {
        const res = await fetch(`/api/skill?name=${encodeURIComponent(name)}`);
        const data = await res.json();
        if (data.error) {
          body.innerText = data.error;
          return;
        }
        body.innerHTML = `
          <div style="margin-bottom: 1rem;">
            <strong>Category:</strong> ${escapeHtml(data.category)}<br>
            <strong>Path:</strong> <code>${escapeHtml(data.path)}</code>
          </div>
          <pre>${escapeHtml(data.content || data.description || 'No content found.')}</pre>
        `;
      } catch (e) {
        body.innerText = 'Failed to load skill: ' + e.message;
      }
    }

    function closeModal() {
      document.getElementById('skillModal').classList.remove('open');
    }

    function renderProfilesView() {
      const grid = document.getElementById('profilesGrid');
      grid.innerHTML = '';
      allProfiles.forEach(p => {
        const card = document.createElement('div');
        card.className = 'skill-card';
        const active = activeSkills[p.name] || [];
        card.innerHTML = `
          <div>
            <div class="card-top">
              <span class="skill-title">👤 ${escapeHtml(p.name)}</span>
              <span class="badge-chip">${active.length} active tools</span>
            </div>
            <div class="card-desc">${escapeHtml(p.description || 'Specialist Hermes Agent Profile')}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem;">
              <strong>Active skills:</strong> ${active.length > 0 ? active.map(s => `<code>${escapeHtml(s)}</code>`).join(', ') : 'None'}
            </div>
          </div>
          <div class="card-actions">
            <button class="btn-action" onclick="document.getElementById('targetProfile').value='${escapeHtml(p.name)}'; switchTab('search'); executeSearch();">Select & Manage</button>
          </div>
