#!/usr/bin/env python3
"""Unified CLI for Hermes SQLite Knowledge Vault."""
import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

DB_CANDIDATES = [
    Path(os.environ.get("HERMES_BASE_HOME", str(Path.home() / ".hermes"))) / "hermes-vault.sqlite",
    Path("/srv/hermes-installer/hermes-vault.sqlite"),
    Path("/home/hermes/.hermes/hermes-vault.sqlite"),
    Path("/root/hermes-vault.sqlite"),
    Path.cwd() / "hermes-vault.sqlite",
]

db_path = next((p for p in DB_CANDIDATES if p.is_file()), None)
if not db_path:
    sys.exit("Error: hermes-vault.sqlite not found.")

conn = sqlite3.connect(db_path)
conn.row_factory = sqlite3.Row
cur = conn.cursor()

def cmd_stats(args):
    import getpass
    current_user = getpass.getuser()
    print("=" * 65)
    print("           HERMES KNOWLEDGE & ECOSYSTEM VAULT (SQLITE)         ")
    print("=" * 65)
    print(f"Database File: {db_path} ({os.path.getsize(db_path)/(1024*1024):.2f} MB)")
    print(f"Runtime User : {current_user} (Isolated Environment)")
    print("-" * 65)
    for row in cur.execute("SELECT key, value FROM metadata ORDER BY key"):
        k = row['key']
        v = row['value']
        if "community" in k.lower():
            continue
        print(f"  {k:<26}: {v}")
    print("=" * 65)

def cmd_skills(args):
    q = f"%{args.query}%" if args.query else "%"
    category = getattr(args, "category", None)
    if category:
        rows = cur.execute(
            "SELECT name, category, description FROM curated_skills WHERE category=? AND (name LIKE ? OR description LIKE ?) ORDER BY name LIMIT ?",
            (category, q, q, args.limit)
        ).fetchall()
    else:
        rows = cur.execute(
            "SELECT name, category, description FROM curated_skills WHERE name LIKE ? OR description LIKE ? ORDER BY name LIMIT ?",
            (q, q, args.limit)
        ).fetchall()
    for r in rows:
        print(f"[{r['category']}] {r['name']}: {r['description'][:80]}...")
    print(f"\nShowing {len(rows)} skills (limit {args.limit})")

def cmd_community(args):
    # Community pool is unified into Curated Skills
    cmd_skills(args)

def cmd_mcp(args):
    q = f"%{args.query}%" if args.query else "%"
    cond = "is_recommended = 1" if args.recommended else "1=1"
    rows = cur.execute(
        f"SELECT server_name, transport, command, is_recommended, description FROM mcp_servers WHERE {cond} AND (server_name LIKE ? OR description LIKE ?) ORDER BY is_recommended DESC, server_name LIMIT ?",
        (q, q, args.limit)
    ).fetchall()
    for r in rows:
        tag = "[RECOMMENDED]" if r["is_recommended"] else "[CATALOG]    "
        print(f"{tag} {r['server_name']:<24} {r['command']:<10} {r['description'][:60]}...")
    print(f"\nShowing {len(rows)} MCP servers")

def cmd_agents(args):
    q = f"%{args.query}%" if args.query else "%"
    rows = cur.execute(
        "SELECT persona_id, name, division, type FROM agent_personas WHERE name LIKE ? OR persona_id LIKE ? ORDER BY division, name LIMIT ?",
        (q, q, args.limit)
    ).fetchall()
    for r in rows:
        print(f"[{r['type']:<14}] {r['division']:<20} {r['name']}")
    print(f"\nShowing {len(rows)} agent personas")

def cmd_engines(args):
    print(f"{'ENGINE':<24} {'TECH':<18} {'BINARY PATH':<30} {'DESCRIPTION'}")
    print("-" * 100)
    for r in cur.execute("SELECT name, technology, binary_path, description FROM engines ORDER BY name"):
        print(f"{r['name']:<24} {r['technology']:<18} {r['binary_path']:<30} {r['description'][:45]}...")

def main():
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="subcommand", required=True)

    sub.add_parser("stats", help="Show system metadata and ecosystem inventory")

    p_skills = sub.add_parser("skills", help="Search curated skills catalog (84,000+ skills)")
    p_skills.add_argument("query", nargs="?", default="", help="Search query")
    p_skills.add_argument("--category", default=None, help="Filter by category")
    p_skills.add_argument("--limit", type=int, default=30)

    p_comm = sub.add_parser("community", help=argparse.SUPPRESS)
    p_comm.add_argument("query", nargs="?", default="", help="Search query")
    p_comm.add_argument("--limit", type=int, default=25)

    p_mcp = sub.add_parser("mcp", help="Search MCP servers")
    p_mcp.add_argument("query", nargs="?", default="", help="Search query")
    p_mcp.add_argument("--recommended", action="store_true", help="Filter recommended servers only")
    p_mcp.add_argument("--limit", type=int, default=30)

    p_agents = sub.add_parser("agents", help="Search agent personas")
    p_agents.add_argument("query", nargs="?", default="", help="Search query")
    p_agents.add_argument("--limit", type=int, default=30)

    sub.add_parser("engines", help="List the 16 extended engines and execution binaries")

    p_rb = sub.add_parser("rulebook", help="View or search Enterprise Rulebook & Governance Protocols")
    p_rb.add_argument("protocol", nargs="?", default=None, help="Protocol number (1-8) or keyword")
    p_rb.add_argument("--search", "-s", default="", help="Search query")
    p_rb.add_argument("--json", "-j", action="store_true", help="Output JSON format")
    p_rb.add_argument("--list", "-l", action="store_true", help="List all 8 protocols")

    args = p.parse_args()
    if args.subcommand == "stats":
        cmd_stats(args)
    elif args.subcommand == "skills":
        cmd_skills(args)
    elif args.subcommand == "community":
        cmd_community(args)
    elif args.subcommand == "mcp":
        cmd_mcp(args)
    elif args.subcommand == "agents":
        cmd_agents(args)
    elif args.subcommand == "engines":
        cmd_engines(args)
    elif args.subcommand == "rulebook":
        cmd = ["hermes-rulebook"]
        if args.json:
            cmd.append("--json")
        elif args.search:
            cmd.extend(["--search", args.search])
        elif args.list:
            cmd.append("--list")
        elif args.protocol:
            cmd.append(args.protocol)
        import subprocess
        subprocess.run(cmd)

if __name__ == "__main__":
    main()
