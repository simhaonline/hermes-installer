    async function loadMcpAndPlugins() {
      const mcpGrid = document.getElementById('mcpGrid');
      const plgGrid = document.getElementById('pluginsGrid');
      mcpGrid.innerHTML = 'Loading MCPs...';
      plgGrid.innerHTML = 'Loading Plugins...';

      try {
        const res = await fetch('/api/mcp-and-plugins');
        const data = await res.json();
        mcpGrid.innerHTML = '';
        plgGrid.innerHTML = '';

        (data.mcps || []).forEach(m => {
          const card = document.createElement('div');
          card.className = 'skill-card';
          card.innerHTML = `
            <div>
              <div class="card-top">
                <span class="skill-title">🔌 ${escapeHtml(m.server_name)}</span>
                <span class="match-badge">Production MCP</span>
              </div>
              <div class="card-desc">${escapeHtml(m.description || 'Enterprise MCP Server')}</div>
            </div>
            <div class="card-actions">
              <code>${escapeHtml(m.command || 'stdio')}</code>
            </div>
          `;
          mcpGrid.appendChild(card);
        });

        (data.plugins || []).forEach(p => {
          const card = document.createElement('div');
          card.className = 'skill-card';
          card.innerHTML = `
            <div>
              <div class="card-top">
                <span class="skill-title">🧩 ${escapeHtml(p.name)}</span>
                <span class="badge-chip">Plugin</span>
              </div>
              <div class="card-desc">${escapeHtml(p.description || 'Enterprise Hermes Agent Plugin')}</div>
            </div>
          `;
          plgGrid.appendChild(card);
        });
      } catch (e) {
        mcpGrid.innerHTML = 'Error loading MCPs: ' + e.message;
      }
    }

    async function loadStatsTab() {
      try {
        const res = await fetch('/api/stats');
        const data = await res.json();
        document.getElementById('statsDetails').innerText = JSON.stringify(data, null, 2);
      } catch (e) {
        document.getElementById('statsDetails').innerText = 'Error: ' + e.message;
      }
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.innerText = msg;
      t.style.display = 'block';
      setTimeout(() => { t.style.display = 'none'; }, 3500);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    window.onload = init;
  </script>
</body>
</html>
"""

class RegistryHTTPHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Clean safe logging
        try:
            msg = format % args
        except Exception:
            msg = " ".join(str(a) for a in args)
        sys.stderr.write(f"[{self.log_date_time_string()}] {msg}\n")

    def do_HEAD(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        if path == "/" or path == "/index.html":
            body = HTML_DASHBOARD.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
        else:
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.end_headers()

    def _send_json(self, data, status=200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path == "/" or path == "/index.html":
            body = HTML_DASHBOARD.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        if path == "/api/stats":
            conn = get_db()
            cur = conn.cursor()
            meta = {r['key']: r['value'] for r in cur.execute("SELECT key, value FROM metadata")}
            counts = {
                "curated_skills": cur.execute("SELECT count(*) FROM curated_skills").fetchone()[0],
                "community_skills": cur.execute("SELECT count(*) FROM community_skills").fetchone()[0],
                "profiles": cur.execute("SELECT count(*) FROM profiles").fetchone()[0],
                "recommended_mcp": cur.execute("SELECT count(*) FROM mcp_servers WHERE is_recommended=1").fetchone()[0],
                "mcp_servers": cur.execute("SELECT count(*) FROM mcp_servers").fetchone()[0],
                "plugins": cur.execute("SELECT count(*) FROM plugins").fetchone()[0],
            }
            client = get_chroma()
            chroma_info = {}
            if client:
                for cname in ['skills_semantic', 'profiles_semantic', 'mcp_semantic', 'plugins_semantic']:
                    try:
                        c = client.get_collection(cname)
                        chroma_info[cname] = c.count()
                    except Exception:
                        chroma_info[cname] = 0

            self._send_json({
                "status": "online",
                "counts": counts,
                "metadata": meta,
                "chromadb": chroma_info,
                "database_size_mb": round(os.path.getsize(db_path)/(1024*1024), 2) if db_path else 0
            })
            return

        if path == "/api/categories":
            conn = get_db()
            cur = conn.cursor()
            rows = cur.execute("SELECT category, count(*) as count FROM curated_skills GROUP BY category ORDER BY count DESC").fetchall()
            self._send_json([{"category": r['category'], "count": r['count']} for r in rows])
            return

        if path == "/api/profiles":
            conn = get_db()
            cur = conn.cursor()
            rows = cur.execute("SELECT name, description FROM profiles ORDER BY name").fetchall()
            active_map = get_active_skills_map()
            self._send_json({
                "profiles": [{"name": r['name'], "description": r['description']} for r in rows],
                "active_map": active_map
            })
            return

        if path == "/api/mcp-and-plugins":
            conn = get_db()
            cur = conn.cursor()
            mcps = cur.execute("SELECT server_name, command, description FROM mcp_servers WHERE is_recommended=1 ORDER BY server_name").fetchall()
            plugins = cur.execute("SELECT name, description FROM plugins ORDER BY name").fetchall()
            self._send_json({
                "mcps": [{"server_name": r['server_name'], "command": r['command'], "description": r['description']} for r in mcps],
                "plugins": [{"name": r['name'], "description": r['description']} for r in plugins]
            })
            return

        if path == "/api/search":
            query = params.get("q", [""])[0].strip()
            cat = params.get("category", [""])[0].strip()
            limit = int(params.get("limit", [24])[0])

            conn = get_db()
            cur = conn.cursor()
            client = get_chroma()

            results = []
            seen = set()

            # 1. Semantic Search if query given
            if query and client:
                try:
                    c_skills = client.get_collection("skills_semantic")
                    where_filter = {"category": cat} if cat else None
                    q_res = c_skills.query(query_texts=[query], n_results=limit, where=where_filter)
                    if q_res and q_res.get('ids') and q_res['ids'][0]:
                        for name, doc, meta, dist in zip(q_res['ids'][0], q_res['documents'][0], q_res['metadatas'][0], q_res['distances'][0]):
                            sim = max(0.0, 1.0 - float(dist))
                            results.append({
                                "name": meta['name'],
                                "category": meta['category'],
                                "description": doc,
                                "score": sim,
                                "match_type": "semantic"
                            })
                            seen.add(meta['name'])
                except Exception:
                    pass

            # 2. FTS5 / SQL Fallback or Enrichment
            if len(results) < limit:
                needed = limit - len(results)
                if query:
                    clean_q = " ".join([w for w in query.replace('"', '').replace("'", '').split() if len(w) > 2])
                    if clean_q:
                        match_clause = " OR ".join(clean_q.split())
                        sql = """
                            SELECT c.name, c.category, c.description, bm25(curated_skills_fts) as score
                            FROM curated_skills_fts f
                            JOIN curated_skills c ON c.id = f.rowid
                            WHERE curated_skills_fts MATCH ?
                        """
                        sql_args = [match_clause]
                        if cat:
                            sql += " AND c.category = ?"
                            sql_args.append(cat)
                        sql += " ORDER BY score ASC LIMIT ?"
                        sql_args.append(needed * 2)

                        try:
                            rows = cur.execute(sql, sql_args).fetchall()
                            for r in rows:
                                if r['name'] not in seen:
                                    results.append({
                                        "name": r['name'],
                                        "category": r['category'],
                                        "description": r['description'],
                                        "score": 0.5,
                                        "match_type": "keyword"
                                    })
                                    seen.add(r['name'])
                        except Exception:
                            pass
                else:
                    # No query: return top from category or default
                    sql = "SELECT name, category, description FROM curated_skills"
                    sql_args = []
                    if cat:
                        sql += " WHERE category = ?"
                        sql_args.append(cat)
                    sql += " ORDER BY id ASC LIMIT ?"
                    sql_args.append(needed)
                    rows = cur.execute(sql, sql_args).fetchall()
                    for r in rows:
                        if r['name'] not in seen:
                            results.append({
                                "name": r['name'],
                                "category": r['category'],
                                "description": r['description'],
                                "score": 1.0,
                                "match_type": "category"
                            })
                            seen.add(r['name'])

            self._send_json({"results": results[:limit]})
            return

        if path == "/api/skill":
            name = params.get("name", [""])[0].strip()
            conn = get_db()
            cur = conn.cursor()
            row = cur.execute("SELECT name, category, description, path FROM curated_skills WHERE name=?", (name,)).fetchone()
            if not row:
                self._send_json({"error": "Skill not found"}, status=404)
                return

            skill_path = Path(row['path'])
            content = ""
            skill_md = skill_path / "SKILL.md" if skill_path.is_dir() else skill_path
            if not skill_md.exists():
                candidate = Path(f"/home/predictatrade/.hermes/skill-library/{row['category']}/{row['name']}/SKILL.md")
                if candidate.exists():
                    skill_md = candidate

            if skill_md.exists() and skill_md.is_file():
                try:
                    content = skill_md.read_text(encoding="utf-8", errors="replace")
                except Exception as e:
                    content = f"Error reading file: {e}"

            self._send_json({
                "name": row['name'],
                "category": row['category'],
                "description": row['description'],
                "path": str(skill_path),
                "content": content
            })
            return

        self._send_json({"error": "Not Found"}, status=404)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        content_len = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_len).decode("utf-8") if content_len > 0 else "{}"
        try:
            payload = json.loads(body)
        except Exception:
            self._send_json({"error": "Invalid JSON"}, status=400)
            return

        skill_name = payload.get("skill", "").strip()
        profile = payload.get("profile", "default").strip() or "default"

        if not skill_name:
            self._send_json({"error": "Missing skill name"}, status=400)
            return

        if path == "/api/activate":
            conn = get_db()
            cur = conn.cursor()
            row = cur.execute("SELECT name, category, path FROM curated_skills WHERE name=?", (skill_name,)).fetchone()
            if not row:
                self._send_json({"error": f"Skill '{skill_name}' not found in registry"}, status=404)
                return

            source_path = Path(row['path'])
            if not source_path.exists():
                candidate = Path(f"/home/predictatrade/.hermes/skill-library/{row['category']}/{row['name']}")
                if candidate.exists():
                    source_path = candidate

            target_dir = Path(f"/home/predictatrade/.hermes/profiles/{profile}/skills/{row['category']}")
            target_dir.mkdir(parents=True, exist_ok=True)
            target_link = target_dir / skill_name

            if target_link.exists() or target_link.is_symlink():
                self._send_json({"success": True, "message": f"'{skill_name}' is already active in '{profile}'."})
                return

            try:
                target_link.symlink_to(source_path)
                self._send_json({
                    "success": True,
                    "message": f"Activated '{skill_name}' into profile '{profile}'.",
                    "target": str(target_link)
                })
            except Exception as e:
                self._send_json({"error": f"Symlink creation failed: {e}"}, status=500)
            return

        if path == "/api/deactivate":
            conn = get_db()
            cur = conn.cursor()
            row = cur.execute("SELECT category FROM curated_skills WHERE name=?", (skill_name,)).fetchone()
            category = row['category'] if row else "*"

            skill_path = Path(f"/home/predictatrade/.hermes/profiles/{profile}/skills/{category}/{skill_name}")
            found = False
            if skill_path.is_symlink() or skill_path.exists():
                skill_path.unlink()
                found = True
            else:
                skills_root = Path(f"/home/predictatrade/.hermes/profiles/{profile}/skills")
                if skills_root.exists():
                    for p in skills_root.rglob(skill_name):
                        if p.is_symlink() or p.exists():
                            p.unlink()
                            found = True

            if found:
                self._send_json({"success": True, "message": f"Evicted '{skill_name}' from profile '{profile}'."})
            else:
                self._send_json({"success": True, "message": f"'{skill_name}' was not active in profile '{profile}'."})
            return

        self._send_json({"error": "Not Found"}, status=404)

class RegistryHTTPServer(ThreadingHTTPServer):
    allow_reuse_address = True

def cmd_ui(args):
