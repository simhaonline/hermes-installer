def get_dashboard_html():
    """Dynamically resolves and reads the institutional dashboard.html template."""
    search_paths = [
        Path(__file__).resolve().parent / "dashboard.html",
        Path("/srv/hermes-installer/dashboard.html"),
        Path("/usr/local/share/hermes/dashboard.html"),
    ]
    for p in search_paths:
        if p.exists() and p.is_file():
            try:
                return p.read_text(encoding="utf-8")
            except Exception:
                pass
    return HTML_FALLBACK_DASHBOARD


class RegistryHTTPHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Clean safe logging
        try:
            msg = format % args
        except Exception:
            msg = " ".join(str(a) for a in args)
        sys.stderr.write(f"[{self.log_date_time_string()}] {msg}\n")

    def do_HEAD(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        if path == "/" or path == "/index.html":
            body = get_dashboard_html().encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
        else:
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.end_headers()

    def _send_json(self, data, status=200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path == "/" or path == "/index.html":
            body = get_dashboard_html().encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        if path == "/favicon.ico":
            fav = Path("/srv/hermes-installer/SIMHA_Brand_Asset_Kit_v1.0.0/favicons/simha_favicon.ico")
            if fav.exists():
                data = fav.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", "image/x-icon")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "public, max-age=86400")
                self.end_headers()
                self.wfile.write(data)
                return

        if path in ("/favicon.svg", "/simha_favicon.svg", "/assets/logo.svg"):
            fav = Path("/srv/hermes-installer/SIMHA_Brand_Asset_Kit_v1.0.0/favicons/simha_favicon.svg")
            if fav.exists():
                data = fav.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", "image/svg+xml")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "public, max-age=86400")
                self.end_headers()
                self.wfile.write(data)
                return

        conn = get_db()
        cur = conn.cursor()
        try:
            self._handle_api_get(path, params, conn, cur)
        finally:
            conn.close()

    def _handle_api_get(self, path, params, conn, cur):
        if path == "/api/stats":
            meta = {r['key']: r['value'] for r in cur.execute("SELECT key, value FROM metadata")}
            counts = {
                "curated_skills": cur.execute("SELECT count(*) FROM curated_skills").fetchone()[0],
                "community_skills": cur.execute("SELECT count(*) FROM community_skills").fetchone()[0],
                "profiles": cur.execute("SELECT count(*) FROM profiles").fetchone()[0],
                "agent_personas": cur.execute("SELECT count(*) FROM agent_personas").fetchone()[0],
                "recommended_mcp": cur.execute("SELECT count(*) FROM mcp_servers WHERE is_recommended=1").fetchone()[0],
                "mcp_servers": cur.execute("SELECT count(*) FROM mcp_servers").fetchone()[0],
                "plugins": cur.execute("SELECT count(*) FROM plugins").fetchone()[0],
            }
            client = get_chroma()
            chroma_info = {}
            if client:
                for cname in ['skills_semantic', 'agents_semantic', 'profiles_semantic', 'mcp_semantic', 'plugins_semantic']:
                    try:
                        c = client.get_collection(cname)
                        chroma_info[cname] = c.count()
                    except Exception:
                        chroma_info[cname] = 0

            self._send_json({
                "status": "online",
                "counts": counts,
                "metadata": meta,
                "chromadb": chroma_info,
                "database_size_mb": round(os.path.getsize(db_path)/(1024*1024), 2) if db_path else 0
            })
            return

        if path == "/api/categories":
            rows = cur.execute("SELECT category, count(*) as count FROM curated_skills GROUP BY category ORDER BY count DESC").fetchall()
            self._send_json([{"category": r['category'], "count": r['count']} for r in rows])
            return

        if path == "/api/profiles":
            rows = cur.execute("SELECT name, description FROM profiles ORDER BY name").fetchall()
            active_map = get_active_skills_map()
            self._send_json({
                "profiles": [{"name": r['name'], "description": r['description']} for r in rows],
                "active_map": active_map
            })
            return

        if path == "/api/mcp-and-plugins":
            mcps = cur.execute("SELECT server_name, command, description FROM mcp_servers WHERE is_recommended=1 ORDER BY server_name").fetchall()
            plugins = cur.execute("SELECT name, description FROM plugins ORDER BY name").fetchall()
            self._send_json({
                "mcps": [{"server_name": r['server_name'], "command": r['command'], "description": r['description']} for r in mcps],
                "plugins": [{"name": r['name'], "description": r['description']} for r in plugins]
            })
            return

        if path == "/api/agents":
            q = params.get("q", [""])[0].strip()
            division = params.get("division", [""])[0].strip()
            try:
                limit = int(params.get("limit", [600])[0])
            except ValueError:
                limit = 600
            try:
                offset = int(params.get("offset", [0])[0])
            except ValueError:
                offset = 0

            sql = "SELECT id, persona_id, name, division, role, type, file_path FROM agent_personas WHERE 1=1"
            count_sql = "SELECT count(*) FROM agent_personas WHERE 1=1"
            sql_args = []

            if division:
                sql += " AND division = ?"
                count_sql += " AND division = ?"
                sql_args.append(division)
            if q:
                sql += " AND (name LIKE ? OR role LIKE ? OR division LIKE ?)"
                count_sql += " AND (name LIKE ? OR role LIKE ? OR division LIKE ?)"
                like_q = f"%{q}%"
                sql_args.extend([like_q, like_q, like_q])

            total_count = cur.execute(count_sql, sql_args).fetchone()[0]

            sql += " ORDER BY name ASC LIMIT ? OFFSET ?"
            sql_args.extend([limit, offset])

            rows = cur.execute(sql, sql_args).fetchall()
            results = [{
                "id": r['id'],
                "persona_id": r['persona_id'],
                "name": r['name'],
                "division": r['division'],
                "role": r['role'],
                "type": r['type'],
                "file_path": r['file_path']
            } for r in rows]

            self._send_json({
                "results": results,
                "agents": results,
                "total": total_count,
                "limit": limit,
                "offset": offset
            })
            return

        if path == "/api/agent":
            name = params.get("name", [""])[0].strip()
            agent_id = params.get("id", [""])[0].strip()

            row = None
            if name:
                row = cur.execute("SELECT id, persona_id, name, division, role, type, file_path, system_prompt FROM agent_personas WHERE name = ? OR persona_id = ?", (name, name)).fetchone()
            elif agent_id:
                row = cur.execute("SELECT id, persona_id, name, division, role, type, file_path, system_prompt FROM agent_personas WHERE id = ? OR persona_id = ?", (agent_id, agent_id)).fetchone()

            if not row:
                self._send_json({"error": "Agent persona not found"}, status=404)
                return

            self._send_json({
                "id": row['id'],
                "persona_id": row['persona_id'],
                "name": row['name'],
                "division": row['division'],
                "role": row['role'],
                "type": row['type'],
                "file_path": row['file_path'],
                "system_prompt": row['system_prompt']
            })
            return

        if path == "/api/mcp-search":
            q = params.get("q", [""])[0].strip()
            try:
                limit = int(params.get("limit", [30])[0])
            except ValueError:
                limit = 30
            try:
                offset = int(params.get("offset", [0])[0])
            except ValueError:
                offset = 0

            if q:
                like_q = f"%{q}%"
                sql = """
                    SELECT server_name, transport, command, args, is_recommended, description
                    FROM mcp_servers
                    WHERE server_name LIKE ? OR description LIKE ?
                    ORDER BY is_recommended DESC, server_name ASC
                    LIMIT ? OFFSET ?
                """
                count_sql = "SELECT count(*) FROM mcp_servers WHERE server_name LIKE ? OR description LIKE ?"
                rows = cur.execute(sql, (like_q, like_q, limit, offset)).fetchall()
                total = cur.execute(count_sql, (like_q, like_q)).fetchone()[0]
            else:
                sql = """
                    SELECT server_name, transport, command, args, is_recommended, description
                    FROM mcp_servers
                    ORDER BY is_recommended DESC, server_name ASC
                    LIMIT ? OFFSET ?
                """
                count_sql = "SELECT count(*) FROM mcp_servers"
                rows = cur.execute(sql, (limit, offset)).fetchall()
                total = cur.execute(count_sql).fetchone()[0]

            mcp_items = [{
                "server_name": r['server_name'],
                "transport": r['transport'],
                "command": r['command'],
                "args": r['args'],
                "is_recommended": r['is_recommended'],
                "description": r['description']
            } for r in rows]
            self._send_json({
                "results": mcp_items,
                "servers": mcp_items,
                "total": total,
                "limit": limit,
                "offset": offset
            })
            return

        if path == "/api/diagnostics":

            integrity = "unknown"
            try:
                row = cur.execute("PRAGMA integrity_check").fetchone()
                if row:
                    integrity = row[0]
            except Exception as e:
                integrity = f"error: {e}"

            db_size_mb = 0.0
            if db_path and os.path.exists(db_path):
                db_size_mb = round(os.path.getsize(db_path) / (1024 * 1024), 2)

            chroma_size_mb = 0.0
            if chroma_path and os.path.exists(chroma_path):
                try:
                    total_bytes = sum(f.stat().st_size for f in Path(chroma_path).rglob('*') if f.is_file())
                    chroma_size_mb = round(total_bytes / (1024 * 1024), 2)
                except Exception:
                    chroma_size_mb = 0.0

            profiles_cnt = cur.execute("SELECT count(*) FROM profiles").fetchone()[0]
            curated_cnt = cur.execute("SELECT count(*) FROM curated_skills").fetchone()[0]
            community_cnt = cur.execute("SELECT count(*) FROM community_skills").fetchone()[0]
            agent_cnt = cur.execute("SELECT count(*) FROM agent_personas").fetchone()[0]
            mcp_cnt = cur.execute("SELECT count(*) FROM mcp_servers").fetchone()[0]
            plugin_cnt = cur.execute("SELECT count(*) FROM plugins").fetchone()[0]

            now_utc = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
            py_ver = f"{platform.python_version()} ({platform.platform()})"
            sys_load = list(os.getloadavg()) if hasattr(os, "getloadavg") else [0.0, 0.0, 0.0]

            self._send_json({
                "status": "healthy",
                "sqlite_integrity": integrity,
                "sqlite_size_mb": db_size_mb,
                "chromadb_size_mb": chroma_size_mb,
                "profiles_count": profiles_cnt,
                "curated_skills": curated_cnt,
                "community_skills": community_cnt,
                "agent_personas": agent_cnt,
                "mcp_servers": mcp_cnt,
                "plugins": plugin_cnt,
                "server_time_utc": now_utc,
                "python_version": py_ver,
                "system_load": sys_load
            })
            return

        if path == "/api/rulebook":
            rulebook_candidates = [
                Path("/srv/hermes-installer/RULEBOOK.md"),
                Path("/usr/local/share/hermes/RULEBOOK.md"),
                Path("/home/predictatrade/.hermes/RULEBOOK.md")
            ]
            rf = next((p for p in rulebook_candidates if p.is_file()), None)
            if not rf:
                self._send_json({"error": "RULEBOOK.md not found"}, status=404)
                return
            content = rf.read_text(encoding="utf-8")
            pattern = r"#{2,3} Protocol (\d+):\s*([^\n]+)\n(.*?)(?=\n#{2,3} Protocol \d+:|\n---\n\*Simha|\n---\n\*Hermes|\Z)"
            matches = re.findall(pattern, content, re.DOTALL)
            protocols = [{
                "protocol": int(num),
                "title": title.strip(),
                "body": body.strip()
            } for num, title, body in matches]
            self._send_json({
                "version": "1.0.0",
                "total_protocols": len(protocols),
                "protocols": protocols,
                "raw_markdown": content
            })
            return

        if path == "/api/scrape/status":
            scraper_exists = os.path.exists("/srv/hermes-installer/scraper.py")
            test_exists = os.path.exists("/srv/hermes-installer/test_scraper.py")
            self._send_json({
                "status": "available" if scraper_exists else "unavailable",
                "scraper_path": "/srv/hermes-installer/scraper.py",
                "test_scraper_path": "/srv/hermes-installer/test_scraper.py",
                "version": "1.0.0"
            })
            return

        if path == "/api/search":
            query = params.get("q", [""])[0].strip()
            cat = params.get("category", [""])[0].strip()
            mode = params.get("mode", ["hybrid"])[0].strip().lower()
            try:
                limit = int(params.get("limit", [24])[0])
            except ValueError:
                limit = 24
            try:
                offset = int(params.get("offset", [0])[0])
            except ValueError:
                offset = 0

            limit = max(1, min(limit, 200))
            offset = max(0, offset)
            client = get_chroma()

            results = []
            seen = set()
            total = 0

            # 1. No query: Pure database pagination (instant, accurate total)
            if not query:
                if cat:
                    total = cur.execute("SELECT count(*) FROM curated_skills WHERE category=?", (cat,)).fetchone()[0]
                else:
                    total = cur.execute("SELECT count(*) FROM curated_skills").fetchone()[0]

                sql = "SELECT name, category, description FROM curated_skills"
                sql_args = []
                if cat:
                    sql += " WHERE category = ?"
                    sql_args.append(cat)
                sql += " ORDER BY id ASC LIMIT ? OFFSET ?"
                sql_args.extend([limit, offset])
                rows = cur.execute(sql, sql_args).fetchall()
                for r in rows:
                    results.append({
                        "name": r['name'],
                        "category": r['category'],
                        "description": r['description'],
                        "score": 1.0,
                        "match_type": "category" if cat else "all"
                    })
            else:
                # 2. Query provided: Hybrid, Semantic, or Keyword
                all_semantic = []
                if mode in ["hybrid", "semantic"] and client:
                    try:
                        c_skills = client.get_collection("skills_semantic")
                        where_filter = {"category": cat} if cat else None
                        fetch_n = min(150, offset + limit * 3)
                        q_res = c_skills.query(query_texts=[query], n_results=fetch_n, where=where_filter)
                        if q_res and q_res.get('ids') and q_res['ids'][0]:
                            for name, doc, meta, dist in zip(q_res['ids'][0], q_res['documents'][0], q_res['metadatas'][0], q_res['distances'][0]):
                                sim = max(0.0, 1.0 - float(dist))
                                all_semantic.append({
                                    "name": meta['name'],
                                    "category": meta['category'],
                                    "description": doc,
                                    "score": round(sim, 3),
                                    "match_type": "semantic"
                                })
                    except Exception:
                        pass

                all_keyword = []
                if mode in ["hybrid", "keyword"] or not all_semantic:
                    clean_q = " ".join([w for w in query.replace('"', '').replace("'", '').split() if len(w) > 2])
                    if clean_q:
                        match_clause = " OR ".join(clean_q.split())
                        sql = """
                            SELECT c.name, c.category, c.description, bm25(curated_skills_fts) as score
                            FROM curated_skills_fts f
                            JOIN curated_skills c ON c.id = f.rowid
                            WHERE curated_skills_fts MATCH ?
                        """
                        sql_args = [match_clause]
                        if cat:
                            sql += " AND c.category = ?"
                            sql_args.append(cat)
                        sql += " ORDER BY score ASC LIMIT 200"

                        try:
                            rows = cur.execute(sql, sql_args).fetchall()
                            for r in rows:
                                all_keyword.append({
                                    "name": r['name'],
                                    "category": r['category'],
                                    "description": r['description'],
                                    "score": 0.5,
                                    "match_type": "keyword"
                                })
                        except Exception:
                            pass

                combined = []
                for item in all_semantic:
                    if item['name'] not in seen:
                        combined.append(item)
                        seen.add(item['name'])
                for item in all_keyword:
                    if item['name'] not in seen:
                        combined.append(item)
                        seen.add(item['name'])

                total = len(combined)
                results = combined[offset:offset+limit]

            self._send_json({
                "results": results,
                "total": total,
                "limit": limit,
                "offset": offset
            })
            return

        if path == "/api/skill":
            name = params.get("name", [""])[0].strip()
            row = cur.execute("SELECT name, category, description, path FROM curated_skills WHERE name=?", (name,)).fetchone()
            if not row:
                self._send_json({"error": "Skill not found"}, status=404)
                return

            skill_path = Path(row['path'])
            content = ""
            skill_md = skill_path / "SKILL.md" if skill_path.is_dir() else skill_path
            if not skill_md.exists():
                candidate = Path(f"/home/predictatrade/.hermes/skill-library/{row['category']}/{row['name']}/SKILL.md")
                if candidate.exists():
                    skill_md = candidate

            if skill_md.exists() and skill_md.is_file():
                try:
                    content = skill_md.read_text(encoding="utf-8", errors="replace")
                except Exception as e:
                    content = f"Error reading file: {e}"

            self._send_json({
                "name": row['name'],
                "category": row['category'],
                "description": row['description'],
                "path": str(skill_path),
                "content": content
            })
            return

        self._send_json({"error": "Not Found"}, status=404)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        content_len = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_len).decode("utf-8") if content_len > 0 else "{}"
        try:
            payload = json.loads(body)
        except Exception:
            self._send_json({"error": "Invalid JSON"}, status=400)
            return

        conn = get_db()
        cur = conn.cursor()
        try:
            self._handle_api_post(path, payload, conn, cur)
        finally:
            conn.close()

    def _handle_api_post(self, path, payload, conn, cur):
        if path == "/api/scrape":
            action = payload.get("action", "scrape").strip().lower()
            if action == "test":
                test_script = "/srv/hermes-installer/test_scraper.py"
                if not os.path.exists(test_script):
                    self._send_json({"error": "test_scraper.py not found on platform"}, status=404)
                    return
                try:
                    res = subprocess.run([sys.executable, test_script], capture_output=True, text=True, timeout=30)
                    out = ((res.stderr or "") + "\n" + (res.stdout or "")).strip()
                    self._send_json({
                        "status": "ok" if res.returncode == 0 else "failed",
                        "passed": res.returncode == 0,
                        "output": out,
                        "health": "healthy" if res.returncode == 0 else "unhealthy"
                    })
                except Exception as e:
                    self._send_json({"error": f"Failed to run test_scraper: {e}"}, status=500)
                return

            # Action: harvest/scrape specific URL
            url = payload.get("url", "").strip()
            if not url:
                self._send_json({"error": "Missing URL to scrape"}, status=400)
                return

            dry_run = bool(payload.get("dry_run", True))
            ingest = bool(payload.get("ingest", False))
            limit = int(payload.get("limit_artifacts", 25))
            limit = max(1, min(limit, 100))

            scraper_script = "/srv/hermes-installer/scraper.py"
            if not os.path.exists(scraper_script):
                self._send_json({"error": "scraper.py not found on platform"}, status=404)
                return

            cmd = [sys.executable, scraper_script, "--sources", url, "--limit-artifacts", str(limit)]
            if dry_run:
                cmd.append("--dry-run")
            elif ingest:
                cmd.append("--ingest")
            else:
                cmd.append("--convert")

            try:
                res = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
                self._send_json({
                    "status": "ok" if res.returncode == 0 else "error",
                    "returncode": res.returncode,
                    "url": url,
                    "dry_run": dry_run,
                    "ingest": ingest,
                    "stdout": res.stdout,
                    "stderr": res.stderr
                })
            except subprocess.TimeoutExpired:
                self._send_json({"error": "Harvest pipeline timed out after 180 seconds."}, status=504)
            except Exception as e:
                self._send_json({"error": f"Scraper execution error: {e}"}, status=500)
            return

        if path == "/api/profiles/active":
            profile_name = payload.get("profile", "").strip()
            if not profile_name:
                self._send_json({"error": "Missing profile name"}, status=400)
                return
            p_dir = Path(f"/home/predictatrade/.hermes/profiles/{profile_name}")
            if not p_dir.exists():
                self._send_json({"error": f"Profile '{profile_name}' does not exist"}, status=404)
                return
            cur.execute("REPLACE INTO metadata (key, value) VALUES ('active_profile', ?)", (profile_name,))
            conn.commit()
            self._send_json({
                "success": True,
                "active_profile": profile_name,
                "message": f"Active profile set to '{profile_name}'."
            })
            return

        skill_name = payload.get("skill", "").strip()
        profile = payload.get("profile", "default").strip() or "default"

        if not skill_name:
            self._send_json({"error": "Missing skill name"}, status=400)
            return

        if path == "/api/activate":
            row = cur.execute("SELECT name, category, path FROM curated_skills WHERE name=?", (skill_name,)).fetchone()
            if not row:
                self._send_json({"error": f"Skill '{skill_name}' not found in registry"}, status=404)
                return

            source_path = Path(row['path'])
            if not source_path.exists():
                candidate = Path(f"/home/predictatrade/.hermes/skill-library/{row['category']}/{row['name']}")
                if candidate.exists():
                    source_path = candidate

            target_dir = Path(f"/home/predictatrade/.hermes/profiles/{profile}/skills/{row['category']}")
            target_dir.mkdir(parents=True, exist_ok=True)
            target_link = target_dir / skill_name

            if target_link.exists() or target_link.is_symlink():
                self._send_json({"success": True, "message": f"'{skill_name}' is already active in '{profile}'."})
                return

            try:
                target_link.symlink_to(source_path)
                self._send_json({
                    "success": True,
                    "message": f"Activated '{skill_name}' into profile '{profile}'.",
                    "target": str(target_link)
                })
            except Exception as e:
                self._send_json({"error": f"Symlink creation failed: {e}"}, status=500)
            return

        if path == "/api/deactivate":
            row = cur.execute("SELECT category FROM curated_skills WHERE name=?", (skill_name,)).fetchone()
            category = row['category'] if row else "*"

            skill_path = Path(f"/home/predictatrade/.hermes/profiles/{profile}/skills/{category}/{skill_name}")
            found = False
            if skill_path.is_symlink() or skill_path.exists():
                skill_path.unlink()
                found = True
            else:
                skills_root = Path(f"/home/predictatrade/.hermes/profiles/{profile}/skills")
                if skills_root.exists():
                    for p in skills_root.rglob(skill_name):
                        if p.is_symlink() or p.exists():
                            p.unlink()
                            found = True

            if found:
                self._send_json({"success": True, "message": f"Evicted '{skill_name}' from profile '{profile}'."})
            else:
                self._send_json({"success": True, "message": f"'{skill_name}' was not active in profile '{profile}'."})
            return

        self._send_json({"error": "Not Found"}, status=404)

class RegistryHTTPServer(ThreadingHTTPServer):
    allow_reuse_address = True

def cmd_ui(args):
    host = args.host
    port = args.port
    server = RegistryHTTPServer((host, port), RegistryHTTPHandler)
    print("=" * 70)
    print("  🌌 HERMES HYBRID VECTOR REGISTRY & WEB DASHBOARD LAUNCHED")
    print("=" * 70)
    print(f"  • Local Dashboard URL : http://{host if host != '0.0.0.0' else 'localhost'}:{port}")
    print(f"  • External Access URL  : http://platform.predictatrade.com:{port}")
    print(f"  • Hybrid Database     : {db_path}")
    print(f"  • ChromaDB Store      : {chroma_path}")
    print("-" * 70)
    print("  Press Ctrl+C to stop the web server.")
