def cmd_view_protocol(proto_num: int):
    rf = find_rulebook()
    content = rf.read_text(encoding="utf-8") if rf.is_file() else ""
    protocols = parse_rulebook_protocols(content)

    target = next((p for p in protocols if p["protocol"] == proto_num), None)
    name = PROTOCOL_NAMES.get(proto_num, f"Protocol {proto_num}")

    print_banner()
    print(f"{GOLD}{BOLD}>>> PROTOCOL 0{proto_num}: {name.upper()} <<<{RESET}\n")

    rules = [r for r in RULES_DB.items() if r[1]["proto_num"] == proto_num]
    print(f"{BOLD}Binary Governance Rules for Protocol 0{proto_num}:{RESET}\n")
    for rid, r in sorted(rules):
        sev_color = RED if r["severity"] == "CRITICAL" else AMBER
        print(f"  • {GOLD}{BOLD}{rid}{RESET} [{sev_color}{r['severity']}{RESET}]: {r['statement']}")
        print(f"    {DIM}Threat: {r['threat']} | Evidence: {r['evidence']}{RESET}\n")

    if target:
        print(f"{BOLD}Operational Directives:{RESET}\n")
        body = target["body"]
        body = re.sub(r"### ([^\n]+)", f"{EMERALD}{BOLD}--- \\1 ---{RESET}", body)
        body = re.sub(r"`([^`]+)`", f"{CYAN}\\1{RESET}", body)
        print(body[:1200] + ("\n... [view RULEBOOK.md for full directives]" if len(body) > 1200 else ""))

    print(f"\n{GOLD}{'=' * 78}{RESET}")

def cmd_search(query: str):
    print_banner()
    print(f"Searching governance database for: {BOLD}'{query}'{RESET}...\n")
    matches = 0
    q = query.lower()

    for rid, r in sorted(RULES_DB.items()):
        if q in rid.lower() or q in r["statement"].lower() or q in r["threat"].lower() or q in r["protocol"].lower():
            matches += 1
            sev_color = RED if r["severity"] == "CRITICAL" else AMBER
            print(f"{GOLD}{BOLD}{rid}{RESET} (Protocol 0{r['proto_num']}: {r['protocol']}) [{sev_color}{r['severity']}{RESET}]")
            print(f"  • {BOLD}Statement:{RESET} {r['statement']}")
            print(f"  • {BOLD}Threat:{RESET}    {r['threat']}\n")

    if matches == 0:
        print(f"No rules found matching query '{query}'.")
    else:
        print(f"{EMERALD}Total matches found: {matches}{RESET}")

