DB_CANDIDATES = [
    Path("/home/predictatrade/.hermes/hermes-vault.sqlite"),
    Path(os.environ.get("HERMES_BASE_HOME", str(Path.home() / ".hermes"))) / "hermes-vault.sqlite",
    Path("/root/hermes-vault.sqlite")
]

CHROMA_CANDIDATES = [
    Path("/home/predictatrade/.hermes/vector-registry"),
    Path(os.environ.get("HERMES_BASE_HOME", str(Path.home() / ".hermes"))) / "vector-registry"
]

db_path = next((p for p in DB_CANDIDATES if p.is_file()), None)
chroma_path = next((p for p in CHROMA_CANDIDATES if p.is_dir()), None)

def get_db():
    if not db_path:
        sys.exit("Error: hermes-vault.sqlite not found.")
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    return conn

def get_chroma():
    try:
        import chromadb
        path = str(chroma_path) if chroma_path else "/home/predictatrade/.hermes/vector-registry"
        return chromadb.PersistentClient(path=path)
    except Exception:
        return None

def get_active_skills_map():
    """Returns a dict mapping profile_name -> set of active skill names."""
    active_map = {}
    profiles_root = Path("/home/predictatrade/.hermes/profiles")
    if not profiles_root.exists():
        return active_map
    
    for prof_dir in profiles_root.iterdir():
        if prof_dir.is_dir():
            skills_dir = prof_dir / "skills"
            active_skills = set()
            if skills_dir.exists():
                for item in skills_dir.rglob("*"):
                    if (item.is_symlink() or item.is_dir()) and (item / "SKILL.md").exists():
                        active_skills.add(item.name)
            active_map[prof_dir.name] = sorted(list(active_skills))
    return active_map

